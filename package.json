{
  "name": "playbook",
  "version": "1.0.0",
  "description": "User-level skills and portable AI-agent rules for Claude Code and Cursor",
  "scripts": {
    "generate": "rulesync generate",
    "generate:user": "rulesync generate --global -f skills,rules",
    "generate:check": "rulesync generate --check",
    "test": "node --test",
    "test:e2e": "node --test \"e2e/*.e2e.js\""
  },
  "keywords": [
    "skills",
    "rules",
    "claude-code",
    "cursor",
    "rulesync"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "rulesync": "16.24.1"
  },
  "bin": {
    "playbook": "bin/playbook.js"
  }
}
